{
  "name": "unisphere-ai",
  "version": "1.0.0",
  "private": true,
  "description": "UniSphere AI productivity and knowledge platform",
  "main": "server/src/server.js",
  "scripts": {
    "server": "node server/src/server.js",
    "server:dev": "nodemon server/src/server.js",
    "client": "npm --prefix client run dev -- --host 0.0.0.0",
    "build": "npm --prefix client run build",
    "dev": "concurrently \"npm run server:dev\" \"npm run client\"",
    "start": "node server/src/server.js",
    "test": "node --test server/tests/*.test.js"
  },
  "keywords": [
    "productivity",
    "study-assistant",
    "inventory",
    "knowledge-base"
  ],
  "author": "Copilot",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "node-appwrite": "^31.0.0",
    "openai": "^7.43.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
